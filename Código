)[1]

if (is.na(nome_real)) {
  stop(
    "Coluna real/real_t1 nao encontrada em Previsoes_teste."
  )
}

prev_long <- previsoes |>
  dplyr::select(
    data,
    dplyr::all_of(nome_real),
    dplyr::all_of(vars_prev)
  ) |>
  tidyr::pivot_longer(
    cols = dplyr::all_of(vars_prev),
    names_to = "modelo",
    values_to = "previsto"
  ) |>
  dplyr::mutate(
    modelo = stringr::str_to_title(
      modelo
    )
  )

p6a <- ggplot2::ggplot() +
  ggplot2::geom_line(
    data = previsoes,
    ggplot2::aes(
      x = data,
      y = .data[[nome_real]]
    ),
    linewidth = 1.1
  ) +
  ggplot2::geom_point(
    data = previsoes,
    ggplot2::aes(
      x = data,
      y = .data[[nome_real]]
    ),
    size = 1.6
  ) +
  ggplot2::geom_line(
    data = prev_long,
    ggplot2::aes(
      x = data,
      y = previsto,
      linetype = modelo
    ),
    linewidth = 0.75
  ) +
  ggplot2::labs(
    title = "A. Observado x previsto",
    x = NULL,
    y = "Indice",
    linetype = NULL
  ) +
  tema_artigo

# -------------------------------------------------------------
# 11.2 Metricas
# -------------------------------------------------------------

metricas_teste <- metricas |>
  dplyr::filter(
    conjunto == "teste"
  ) |>
  dplyr::select(
    modelo,
    rmse,
    mae,
    mape
  ) |>
  tidyr::pivot_longer(
    cols = c(
      rmse,
      mae,
      mape
    ),
    names_to = "metrica",
    values_to = "valor"
  ) |>
  dplyr::mutate(
    metrica = dplyr::recode(
      metrica,
      rmse = "RMSE",
      mae = "MAE",
      mape = "MAPE (%)"
    )
  )

p6b <- ggplot2::ggplot(
  metricas_teste,
  ggplot2::aes(
    x = modelo,
    y = valor
  )
) +
  ggplot2::geom_col() +
  ggplot2::facet_wrap(
    ~ metrica,
    scales = "free_y"
  ) +
  ggplot2::labs(
    title = "B. Erro no conjunto de teste",
    x = NULL,
    y = NULL
  ) +
  tema_artigo +
  ggplot2::theme(
    axis.text.x = ggplot2::element_text(
      angle = 30,
      hjust = 1
    )
  )

# -------------------------------------------------------------
# 11.3 SHAP top 10
# -------------------------------------------------------------

nome_feature <- intersect(
  c(
    "feature",
    "variavel"
  ),
  names(shap)
)[1]

nome_shap <- intersect(
  c(
    "mean_abs_shap",
    "media_abs_shap"
  ),
  names(shap)
)[1]

shap_top <- shap |>
  dplyr::filter(
    !is.na(
      .data[[nome_shap]]
    )
  ) |>
  dplyr::arrange(
    dplyr::desc(
      .data[[nome_shap]]
    )
  ) |>
  dplyr::slice_head(
    n = 10
  )

p6c <- ggplot2::ggplot(
  shap_top,
  ggplot2::aes(
    x = reorder(
      .data[[nome_feature]],
      .data[[nome_shap]]
    ),
    y = .data[[nome_shap]]
  )
) +
  ggplot2::geom_col() +
  ggplot2::coord_flip() +
  ggplot2::labs(
    title = "C. Importancia global SHAP",
    x = NULL,
    y = "Media |SHAP|"
  ) +
  tema_artigo

# -------------------------------------------------------------
# 11.4 Residuos do melhor modelo
# -------------------------------------------------------------

melhor_modelo <- metricas |>
  dplyr::filter(
    conjunto == "teste"
  ) |>
  dplyr::arrange(
    rmse
  ) |>
  dplyr::slice(1) |>
  dplyr::pull(modelo)

melhor_coluna <- names(previsoes)[
  stringr::str_to_lower(
    names(previsoes)
  ) ==
    stringr::str_to_lower(
      melhor_modelo
    )
][1]

if (
  is.na(melhor_coluna)
) {
  
  candidatos <- vars_prev
  
  melhor_coluna <- candidatos[
    stringr::str_detect(
      stringr::str_to_lower(
        candidatos
      ),
      stringr::str_to_lower(
        melhor_modelo
      )
    )
  ][1]
}

residuos_melhor <- previsoes |>
  dplyr::transmute(
    data = data,
    residuo =
      .data[[nome_real]] -
      .data[[melhor_coluna]]
  )

p6d <- ggplot2::ggplot(
  residuos_melhor,
  ggplot2::aes(
    x = data,
    y = residuo
  )
) +
  ggplot2::geom_hline(
    yintercept = 0,
    linetype = "dashed"
  ) +
  ggplot2::geom_line(
    linewidth = 0.8
  ) +
  ggplot2::geom_point(
    size = 1.6
  ) +
  ggplot2::labs(
    title = paste0(
      "D. Residuos - ",
      melhor_modelo
    ),
    x = "Data",
    y = "Erro"
  ) +
  tema_artigo

fig6 <- (
  p6a |
    p6b
) /
  (
    p6c |
      p6d
  ) +
  patchwork::plot_annotation(
    title = "Figura 6. Desempenho e interpretabilidade dos modelos"
  )

ggplot2::ggsave(
  file.path(
    pasta_saida,
    "FIGURA_6_MODELOS_COMPLETA.png"
  ),
  fig6,
  width = 14,
  height = 10,
  dpi = 320
)

