# 7. FUNCAO DE CORRELACAO PARA FIGURAS 3 E 4
# =====================================================================

calcular_correlacoes <- function(
    dados,
    respostas,
    preditores
) {
  
  resultados <- list()
  
  for (resp in respostas) {
    
    if (!resp %in% names(dados)) {
      next
    }
    
    for (pred in preditores) {
      
      if (!pred %in% names(dados)) {
        next
      }
      
      temp <- dados |>
        dplyr::select(
          dplyr::all_of(
            c(
              resp,
              pred
            )
          )
        ) |>
        tidyr::drop_na()
      
      if (
        nrow(temp) < 5 ||
        length(unique(temp[[pred]])) < 3
      ) {
        next
      }
      
      teste <- suppressWarnings(
        stats::cor.test(
          temp[[resp]],
          temp[[pred]],
          method = "spearman",
          exact = FALSE
        )
      )
      
      resultados[[length(resultados) + 1]] <-
        tibble::tibble(
          resposta = resp,
          preditor = pred,
          n = nrow(temp),
          rho = unname(
            teste$estimate
          ),
          p = teste$p.value
        )
    }
  }
  
  dplyr::bind_rows(
    resultados
  )
}

