padronizar_nomes <- function(nomes) {
  
  nomes |>
    stringr::str_replace_all("\ufeff", "") |>
    stringr::str_trim() |>
    iconv(
      from = "",
      to = "ASCII//TRANSLIT"
    ) |>
    stringr::str_to_lower() |>
    stringr::str_replace_all(
      "[^a-z0-9_]+",
      "_"
    ) |>
    stringr::str_replace_all(
      "_+",
      "_"
    ) |>
    stringr::str_remove("^_") |>
    stringr::str_remove("_$")
}

zscore_seguro <- function(x) {
  
  if (
    all(is.na(x)) ||
    sum(!is.na(x)) < 2 ||
    sd(x, na.rm = TRUE) == 0
  ) {
    return(
      rep(
        NA_real_,
        length(x)
      )
    )
  }
  
  as.numeric(
    scale(x)
  )
}

p_sig <- function(p) {
  
  dplyr::case_when(
    is.na(p) ~ "",
    p < 0.001 ~ "***",
    p < 0.01 ~ "**",
    p < 0.05 ~ "*",
    TRUE ~ ""
  )
}

